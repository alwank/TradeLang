// Normative TradeLang v1 grammar. Whitespace/indentation/newlines are insignificant.
start: version? header market timeframe let_decl* entry exit risk? backtest
version: (_TRADELANG_VERSION_PREFIX | _K_DSL) _K_ONE
header: _K_STRATEGY STRING
market: _K_MARKET SYMBOL
timeframe: _K_TIMEFRAME TIMEFRAME
let_decl: _K_LET NAME "=" expr
entry: _K_ENTRY ":" _K_WHEN expr _K_BUY _K_USING sizing
exit: _K_EXIT ":" _K_WHEN expr _K_SELL _K_ALL
sizing: expr _K_OF _K_EQUITY -> equity_fraction
      | expr CURRENCY       -> fixed_money
risk: _K_RISK ":" stop? target? max_positions?
stop: _K_STOP _K_LOSS expr
target: _K_TAKE _K_PROFIT expr
max_positions: _K_MAX _K_OPEN _K_POSITIONS _K_ONE
backtest: _K_BACKTEST ":" window capital fee slippage execution calendar
window: _K_FROM DATE _K_TO DATE
capital: _K_CAPITAL NUMBER CURRENCY
fee: _K_FEE NUMBER _K_BPS _K_PER _K_SIDE
slippage: _K_SLIPPAGE NUMBER _K_BPS _K_PER _K_SIDE
execution: _K_EXECUTE _K_AT _K_NEXT _K_BAR _K_OPEN
calendar: _K_CALENDAR _K_24X7
?expr: or_expr
?or_expr: or_expr _K_OR and_expr -> bool_or
        | and_expr
?and_expr: and_expr _K_AND not_expr -> bool_and
         | not_expr
?not_expr: _K_NOT not_expr -> bool_not
         | comparison
?comparison: sum comparator sum -> compare
           | sum _K_CROSSES _K_ABOVE sum -> crosses_above
           | sum _K_CROSSES _K_BELOW sum -> crosses_below
           | sum
comparator: ">=" -> greater_equal
          | "<=" -> less_equal
          | "==" -> equal
          | "!=" -> not_equal
          | ">" -> greater
          | "<" -> less
          | _K_IS _K_ABOVE -> greater
          | _K_IS _K_BELOW -> less
?sum: sum "+" term -> add
    | sum "-" term -> subtract
    | term
?term: term "*" unary -> multiply
     | term "/" unary -> divide
     | unary
?unary: "+" unary -> positive
      | "-" unary -> negative
      | power
?power: postfix "**" unary -> exponent
      | postfix
?postfix: atom suffix*
suffix: "[" UINT "]" -> offset
      | "." NAME -> field
?atom: NUMBER "%" -> percent
     | NUMBER UNIT -> typed_number
     | NUMBER -> number
     | _K_TRUE -> true
     | _K_FALSE -> false
     | NAME -> reference
     | function
     | "(" expr ")" -> grouped
function: FUNCTION "(" arguments? ")"
arguments: expr ("," expr)*
// Keep this terminal outside the _K_ prefix used to collect reserved identifiers.
_TRADELANG_VERSION_PREFIX.2: /\btradelang\b/
_K_DSL.2: /\bdsl\b/
_K_ONE.2: /\b1\b/
_K_STRATEGY.2: /\bstrategy\b/
_K_MARKET.2: /\bmarket\b/
_K_TIMEFRAME.2: /\btimeframe\b/
_K_LET.2: /\blet\b/
_K_ENTRY.2: /\bentry\b/
_K_WHEN.2: /\bwhen\b/
_K_BUY.2: /\bbuy\b/
_K_USING.2: /\busing\b/
_K_EXIT.2: /\bexit\b/
_K_SELL.2: /\bsell\b/
_K_ALL.2: /\ball\b/
_K_OF.2: /\bof\b/
_K_EQUITY.2: /\bequity\b/
_K_RISK.2: /\brisk\b/
_K_STOP.2: /\bstop\b/
_K_LOSS.2: /\bloss\b/
_K_TAKE.2: /\btake\b/
_K_PROFIT.2: /\bprofit\b/
_K_MAX.2: /\bmax\b/
_K_OPEN.2: /\bopen\b/
_K_POSITIONS.2: /\bpositions\b/
_K_BACKTEST.2: /\bbacktest\b/
_K_FROM.2: /\bfrom\b/
_K_TO.2: /\bto\b/
_K_CAPITAL.2: /\bcapital\b/
_K_FEE.2: /\bfee\b/
_K_BPS.2: /\bbps\b/
_K_PER.2: /\bper\b/
_K_SIDE.2: /\bside\b/
_K_SLIPPAGE.2: /\bslippage\b/
_K_EXECUTE.2: /\bexecute\b/
_K_AT.2: /\bat\b/
_K_NEXT.2: /\bnext\b/
_K_BAR.2: /\bbar\b/
_K_CALENDAR.2: /\bcalendar\b/
_K_24X7.2: /\b24x7\b/
_K_OR.2: /\bor\b/
_K_AND.2: /\band\b/
_K_NOT.2: /\bnot\b/
_K_CROSSES.2: /\bcrosses\b/
_K_ABOVE.2: /\babove\b/
_K_BELOW.2: /\bbelow\b/
_K_IS.2: /\bis\b/
_K_TRUE.2: /\btrue\b/
_K_FALSE.2: /\bfalse\b/
FUNCTION.2: /\b(?:SMA|EMA|RSI|MACD|ATR|BBANDS|HIGHEST|LOWEST|ROC|STDDEV)\b/
UNIT.2: /\b(?:price|volume|money|count)\b/
TIMEFRAME: /\b[1-9][0-9]*(m|h|d)\b/
DATE: /\b[0-9]{4}-[0-9]{2}-[0-9]{2}\b/
SYMBOL: /\b[A-Z0-9][A-Z0-9_.-]{0,31}(?![A-Za-z0-9_.-])/
CURRENCY: /\b[A-Z][A-Z0-9]{1,11}\b/
NAME: /[a-z_][a-z0-9_]*/
UINT: /0|[1-9][0-9]*/
NUMBER: /(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?(?![A-Za-z0-9_])/
%import common.ESCAPED_STRING -> STRING
%import common.WS
%ignore WS
%ignore /#[^\r\n]*/
