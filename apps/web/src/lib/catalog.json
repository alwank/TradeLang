  "examples": [
    {
      "name": "RSI Trend Recovery",
      "source": "tradelang 1\nstrategy \"RSI Trend Recovery\"\nentry:\n  when RSI(14) crosses above 30 and close is above SMA(200)\n  buy using 20% of equity\nexit:\n  when RSI(14) crosses above 70\n  sell all\nrisk:\n  stop loss 3%\n  take profit 6%\n  max open positions 1\nbacktest:\n  from 2022-01-01 to 2025-12-31\n  capital 10000 USDT\n  fee 10 bps per side\n  slippage 5 bps per side\n  execute at next bar open\n  calendar 24x7\n"
    },
    {
      "name": "EMA Crossover",
      "source": "strategy \"EMA Crossover\"\nentry:\n  when EMA(20) crosses above EMA(50)\n  buy using (10% + 10%) of equity\nexit:\n  when EMA(20) crosses below EMA(50)\n  sell all\nbacktest:\n  from 2022-01-01 to 2025-12-31\n  capital 10000 USDT\n  fee 10 bps per side\n  slippage 5 bps per side\n  execute at next bar open\n  calendar 24x7\n"
    },
    {
      "name": "Previous High Breakout",
      "source": "strategy \"Previous High Breakout\"\nlet boundary = HIGHEST(high, 20)[1]\nentry:\n  when close crosses above boundary\n  buy using (2 * 500) USDT\nexit:\n  when close < EMA(20)\n  sell all\nrisk:\n  stop loss 2 * ATR(14)\n  take profit 4 * ATR(14)\nbacktest:\n  from 2022-01-01 to 2025-12-31\n  capital 10000 USDT\n  fee 10 bps per side\n  slippage 5 bps per side\n  execute at next bar open\n  calendar 24x7\n"
    },
    {
      "name": "Arithmetic Volatility Deviation",
      "source": "strategy \"Arithmetic Volatility Deviation\"\nlet fast = EMA(12)\nlet slow = EMA(26)\nlet spread = fast - slow\nlet deviation = (close - SMA(20)) / SMA(20)\nlet volume_confirmed = volume > 1.5 * SMA(volume, 20)\nlet entry_ready = deviation > 2%\n  and volume_confirmed\n  and spread crosses above 0\nlet exit_ready = close < EMA(20) - 0.5 * ATR(14)\nentry:\n  when entry_ready\n  buy using (10% + 5% * (close / SMA(20))) of equity\nexit:\n  when exit_ready\n  sell all\nrisk:\n  stop loss 2 * ATR(14)\n  take profit 4 * ATR(14)\nbacktest:\n  from 2022-01-01 to 2025-12-31\n  capital 10000 USDT\n  fee 10 bps per side\n  slippage 5 bps per side\n  execute at next bar open\n  calendar 24x7\n"
    }
  ]
