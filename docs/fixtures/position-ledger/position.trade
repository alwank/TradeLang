tradelang 6
strategy "Partial exits and an add"
market TESTUSDT
timeframe 1d
param first_fraction: ratio = 25%
entry:
  when close == 100 price
  buy using 1010 USDT
exit:
  rule first_trim when close == 115 price sell first_fraction of position
  rule second_trim when close == 121 price sell 40% of position
  rule finish when close == 130 price sell all
scale:
  when close == 105 price
  add using 252.5 USDT
risk:
  stop loss 20%
  quantity step 0.5 units
backtest:
  from 2024-01-01 to 2024-01-06
  capital 2000 USDT
  fee 100 bps per side
  slippage 0 bps per side
  execute at next bar open
  calendar 24x7
