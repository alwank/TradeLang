strategy "Arithmetic Volatility Deviation"
market BTCUSDT
timeframe 1h
let fast = EMA(12)
let slow = EMA(26)
let spread = fast - slow
let deviation = (close - SMA(20)) / SMA(20)
let volume_confirmed = volume > 1.5 * SMA(volume, 20)
let entry_ready = deviation > 2%
  and volume_confirmed
  and spread crosses above 0
let exit_ready = close < EMA(20) - 0.5 * ATR(14)
entry:
  when entry_ready
  buy using (10% + 5% * (close / SMA(20))) of equity
exit:
  when exit_ready
  sell all
risk:
  stop loss 2 * ATR(14)
  take profit 4 * ATR(14)
backtest:
  from 2022-01-01 to 2025-12-31
  capital 10000 USDT
  fee 10 bps per side
  slippage 5 bps per side
  execute at next bar open
  calendar 24x7
